  "talk": [
    { "text": "Where the unwholesome moment had its four constant companions, the beautiful moment has nineteen. " },
    { "term": "saddha", "surface": "saddhā" },
    { "text": " clears the water; " },
    { "term": "sati", "surface": "sati" },
    { "text": " keeps watch; " },
    { "term": "hiri", "surface": "hiri" },
    { "text": " and " },
    { "term": "ottappa", "surface": "ottappa" },
    { "text": " guard the door from within and without. " },
    { "term": "alobha", "surface": "alobha" },
    { "text": " is the open hand and " },
    { "term": "adosa", "surface": "adosa" },
    { "text": " the warm heart — " },
    { "term": "metta", "surface": "mettā" },
    { "text": " by another name — while " },
    { "term": "tatramajjhattata", "surface": "tatramajjhattatā" },
    { "text": " holds the whole ensemble level, the way " },
    { "term": "upekkha", "surface": "upekkhā" },
    { "text": " holds the heart level. Twelve more come as six pairs." }
  ],
  "suttaRec": {
    "title": "Cariya — Conduct",
    "ref": "an2.9",
    "url": "https://suttacentral.net/an2.9",
    "blurb": "Hiri and ottappa as the two bright qualities that protect the world — without them, the Buddha says, no one would recognise mother, aunt, or teacher's wife.",
    "minutes": 2
  }

  "talk": [
    { "text": "Six qualities, each named twice — for the factors and for the mind. Tranquility: " },
    { "term": "kayapassaddhi", "surface": "kāyapassaddhi" },
    { "text": " and " },
    { "term": "cittapassaddhi", "surface": "cittapassaddhi" },
    { "text": ", the " },
    { "term": "passaddhi", "surface": "passaddhi" },
    { "text": " of the bojjhaṅgas split in two. Lightness: " },
    { "term": "kayalahuta", "surface": "kāyalahutā" },
    { "text": " and " },
    { "term": "cittalahuta", "surface": "cittalahutā" },
    { "text": ". Pliancy: " },
    { "term": "kayamuduta", "surface": "kāyamudutā" },
    { "text": " and " },
    { "term": "cittamuduta", "surface": "cittamudutā" },
    { "text": ". Workability: " },
    { "term": "kayakammannata", "surface": "kāyakammaññatā" },
    { "text": " and " },
    { "term": "cittakammannata", "surface": "cittakammaññatā" },
    { "text": ". Proficiency: " },
    { "term": "kayapagunnata", "surface": "kāyapāguññatā" },
    { "text": " and " },
    { "term": "cittapagunnata", "surface": "cittapāguññatā" },
    { "text": ". Rectitude: " },
    { "term": "kayujukata", "surface": "kāyujukatā" },
    { "text": " and " },
    { "term": "cittujukata", "surface": "cittujukatā" },
    { "text": ". Together they describe a mind that is calm, light, soft, usable, sound, and straight — the felt texture of a wholesome moment." }
  ],
  "suttaRec": {
    "title": "Pabhassara — Luminous",
    "ref": "an1.41-50",
    "url": "https://suttacentral.net/an1.41-50",
    "blurb": "The mind is luminous, but defiled by adventitious defilements — the one-line sutta the beautiful factors elaborate.",
    "minutes": 1
  }
}

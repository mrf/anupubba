{
  "name": "anupubba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gamified Pali vocabulary for dharma practitioners — gradual, step-by-step, in due order",
  "license": "MIT",
  "author": "Mark Ferree",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "icons": "node scripts/gen-icons.mjs",
    "audio": "node --experimental-strip-types --no-warnings scripts/gen-audio.mjs",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^11.0.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
